---
import FloatActions from "../components/FloatActions.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteMeta } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageClass?: string;
  noindex?: boolean;
  ogType?: string;
}

const {
  title = siteMeta.name,
  description = siteMeta.description,
  image = siteMeta.heroImage,
  pageClass = "",
  noindex = false,
  ogType = "website"
} = Astro.props;

const fullTitle = title === siteMeta.name ? title : `${title} | ${siteMeta.name}`;
const siteOrigin = Astro.site ?? new URL("https://example.com");
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImage = new URL(image, siteOrigin).toString();
const isPlaceholderDomain = siteOrigin.hostname === "example.com";
const robotsDirective = noindex || isPlaceholderDomain ? "noindex, nofollow" : "index, follow, max-image-preview:large";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective} />
    <meta name="googlebot" content={robotsDirective} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="theme-color" content="#24301c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <slot name="head" />
    <title>{fullTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js-ready");
    </script>
  </head>
  <body class={pageClass}>
    <div class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-bar" data-scroll-progress></span>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatActions />

    <script>
      import { animate, inView, scroll } from "motion";

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isCompactViewport = window.innerWidth <= 820;
      const supportsFinePointer = window.matchMedia("(pointer: fine)").matches;
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      const progressBar = document.querySelector<HTMLElement>("[data-scroll-progress]");
      const heroDepth = document.querySelector<HTMLElement>("[data-scroll-hero]");
      const galleryDepth = document.querySelector<HTMLElement>("[data-scroll-gallery]");
      const galleryMotionSections = Array.from(document.querySelectorAll<HTMLElement>(".gallery-motion"));
      const itineraryStories = Array.from(document.querySelectorAll<HTMLElement>("[data-itinerary-story]"));

      const readDelay = (element: HTMLElement) => {
        const delayMs = Number.parseFloat(getComputedStyle(element).getPropertyValue("--delay")) || 0;
        return delayMs / 1000;
      };

      const setupItineraryStory = (story: HTMLElement) => {
        const beats = Array.from(story.querySelectorAll<HTMLElement>("[data-itinerary-beat]"));
        const stops = Array.from(story.querySelectorAll<HTMLElement>("[data-itinerary-stop]"));
        const progressNode = story.querySelector<HTMLElement>("[data-itinerary-progress]");
        const activeLabel = story.querySelector<HTMLElement>("[data-itinerary-active-label]");
        const activeTitle = story.querySelector<HTMLElement>("[data-itinerary-active-title]");

        if (!beats.length) return;

        const setActiveBeat = (index: number, progress = 0) => {
          const activeBeat = beats[Math.min(beats.length - 1, Math.max(0, index))];
          if (!activeBeat) return;

          const stopIndexes = new Set(
            (activeBeat.dataset.itineraryStops || "")
              .split(",")
              .map((value) => value.trim())
              .filter(Boolean)
          );

          beats.forEach((beat, beatIndex) => {
            beat.classList.toggle("is-active", beatIndex === index);
          });

          stops.forEach((stop) => {
            const stopIndex = stop.dataset.itineraryStopIndex || "";
            stop.classList.toggle("is-active", stopIndexes.has(stopIndex));
          });

          if (activeLabel) activeLabel.textContent = activeBeat.dataset.itineraryBeatLabel || "";
          if (activeTitle) activeTitle.textContent = activeBeat.dataset.itineraryBeatTitle || "";
          if (progressNode) progressNode.style.transform = `scaleX(${(0.18 + progress * 0.82).toFixed(3)})`;
          story.style.setProperty("--itinerary-progress", progress.toFixed(3));
        };

        if (prefersReducedMotion || window.innerWidth <= 1080) {
          setActiveBeat(0, 0);
          return;
        }

        scroll(
          (progress: number) => {
            const clampedProgress = Math.max(0, Math.min(1, progress));
            const activeIndex = Math.min(beats.length - 1, Math.floor(clampedProgress * beats.length));
            setActiveBeat(activeIndex, clampedProgress);
          },
          {
            target: story,
            offset: ["start start", "end end"]
          }
        );

        setActiveBeat(0, 0);
      };

      if (prefersReducedMotion) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        revealItems.forEach((item) => {
          inView(
            item,
            (element) => {
              const target = element as HTMLElement;
              if (target.dataset.revealed === "true") return;
              target.dataset.revealed = "true";
              target.classList.add("is-visible");

              animate(
                target,
                isCompactViewport || !supportsFinePointer
                  ? { opacity: [0, 1], y: [18, 0] }
                  : { opacity: [0, 1], y: [28, 0], filter: ["blur(10px)", "blur(0px)"] },
                {
                  duration: isCompactViewport ? 0.58 : 0.8,
                  delay: readDelay(target),
                  ease: [0.2, 0.75, 0.15, 1]
                }
              );
            },
            {
              amount: 0.2,
              margin: "0px 0px -8% 0px"
            }
          );
        });

        if (progressBar && window.innerWidth > 640) {
          const progressAnimation = animate(progressBar, { scaleX: [0, 1] }, { ease: "linear" });
          scroll(progressAnimation);
        }

        if (heroDepth && window.innerWidth > 720) {
          scroll(
            (progress: number) => {
              heroDepth.style.setProperty("--hero-scroll-progress", progress.toFixed(3));
            },
            {
              target: heroDepth,
              offset: ["start end", "end start"]
            }
          );
        }

        if (galleryDepth) {
          scroll(
            (progress: number) => {
              galleryDepth.style.setProperty("--gallery-scroll-progress", progress.toFixed(3));
            },
            {
              target: galleryDepth,
              offset: ["start end", "end start"]
            }
          );
        }
      }

      if (!prefersReducedMotion && "IntersectionObserver" in window && galleryMotionSections.length) {
        const galleryAnimationObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const target = entry.target as HTMLElement;
              target.classList.toggle("is-animating", entry.isIntersecting);
            });
          },
          {
            threshold: [0, 0.08, 0.25]
          }
        );

        galleryMotionSections.forEach((section) => galleryAnimationObserver.observe(section));
      }

      itineraryStories.forEach(setupItineraryStory);
    </script>
  </body>
</html>
