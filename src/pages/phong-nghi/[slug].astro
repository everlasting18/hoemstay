---
import MainLayout from "../../layouts/MainLayout.astro";
import type { Room, RoomMedia } from "../../data/site";
import { rooms, siteMeta } from "../../data/site";

export function getStaticPaths() {
  return rooms.map((room) => ({
    params: { slug: room.slug },
    props: { room }
  }));
}

interface Props {
  room: Room;
}

const { room } = Astro.props as Props;
const relatedRooms = rooms.filter((item) => item.slug !== room.slug).slice(0, 2);
const roomIndex = Math.max(
  0,
  rooms.findIndex((item) => item.slug === room.slug)
);
const roomOrder = String(roomIndex + 1).padStart(2, "0");
const pageTitle = `${room.name} | Chi tiết phòng`;
const pageDescription = `${room.summary} ${room.description}`;
const roomGallery: RoomMedia[] =
  room.media?.length
    ? room.media.filter((item) => item?.src?.trim().length > 0)
    : room.images
        .filter(Boolean)
        .map((src, index) => ({
          type: "image" as const,
          src,
          title: index === 0 ? room.name : undefined
        }));
const roomGalleryMain = roomGallery[0] ?? {
  type: "image" as const,
  src: siteMeta.heroImage,
  title: room.name
};
const roomGalleryRest = roomGallery.slice(1);
const roomGalleryGridMode =
  roomGalleryRest.length <= 3
    ? "is-simple"
    : roomGalleryRest.length <= 6
      ? "is-balanced"
      : "is-rich";
const roomGalleryImageCount = roomGallery.filter((item) => item.type === "image").length;
const roomGalleryVideoCount = roomGallery.filter((item) => item.type === "video").length;
const siteOrigin = Astro.site ?? new URL("https://example.com");
const roomUrl = new URL(`/phong-nghi/${room.slug}/`, siteOrigin).toString();
const roomImagesForSchema = roomGallery
  .filter((media) => media.type === "image")
  .slice(0, 8)
  .map((media) => new URL(media.src, siteOrigin).toString());
const roomStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Trang chủ",
        item: new URL("/", siteOrigin).toString()
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Phòng nghỉ",
        item: new URL("/#phong-nghi", siteOrigin).toString()
      },
      {
        "@type": "ListItem",
        position: 3,
        name: room.name,
        item: roomUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HotelRoom",
    name: room.name,
    description: room.description,
    url: roomUrl,
    image: roomImagesForSchema.length ? roomImagesForSchema : [new URL(roomGalleryMain.src, siteOrigin).toString()],
    occupancy: {
      "@type": "QuantitativeValue",
      value: Number(room.guests.match(/\d+/)?.[0] ?? 2)
    },
    amenityFeature: room.amenities.map((amenity) => ({
      "@type": "LocationFeatureSpecification",
      name: amenity,
      value: true
    })),
    containedInPlace: {
      "@type": "LodgingBusiness",
      name: siteMeta.name,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Tri Tôn",
        addressRegion: "An Giang",
        addressCountry: "VN"
      }
    }
  }
];
---

<MainLayout title={pageTitle} description={pageDescription} image={roomGalleryMain.src} pageClass="room-detail-page" ogType="article">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(roomStructuredData)}></script>
  </Fragment>

  <section class="section room-detail-hero">
    <div class="container">
      <nav class="room-breadcrumb" aria-label="Điều hướng breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/#phong-nghi">Phòng nghỉ</a>
        <span>/</span>
        <strong>{room.name}</strong>
      </nav>

      <article class="room-detail-hero-panel" data-reveal>
        <div class="room-detail-hero-media">
          <img src={room.images[0]} alt={room.name} loading="eager" />
        </div>

        <div class="room-detail-hero-content">
          <p class="eyebrow">Phòng lưu trú {roomOrder}</p>
          <h1>{room.name}</h1>
          <p class="room-detail-summary">{room.summary}</p>
          <p>{room.description}</p>

          <div class="room-detail-stats">
            <article class="page-stat">
              <strong>{room.guests}</strong>
              <span>Sức chứa tối ưu</span>
            </article>
            <article class="page-stat">
              <strong>{room.area}</strong>
              <span>Diện tích sử dụng</span>
            </article>
            <article class="page-stat">
              <strong>{room.view}</strong>
              <span>Không gian nhìn ra</span>
            </article>
          </div>

          <div class="quick-links">
            <a class="btn btn-primary" href={siteMeta.contact.zalo} target="_blank" rel="noreferrer">
              Chat Zalo ngay
            </a>
            <a class="btn btn-secondary" href={siteMeta.contact.phoneHref}>
              {siteMeta.contact.phoneDisplay}
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section room-detail-gallery-section">
    <div class="container">
      <div class="section-heading section-heading-compact" data-reveal>
        <p class="eyebrow">Hình ảnh phòng</p>
        <h2>Góc chụp thực tế của {room.name}</h2>
        <p>Ảnh và video thực tế giúp khách hình dung rõ bố cục phòng, tầm nhìn và trải nghiệm lưu trú.</p>
      </div>

      <div class="room-gallery-toolbar" data-reveal style="--delay:70ms">
        <p class="room-gallery-caption">Bộ media thật tại chỗ, phù hợp khi cần mô tả phòng với nhiều góc quay.</p>
        <div class="room-gallery-stats">
          <span class="chip">{roomGalleryImageCount} ảnh</span>
          {roomGalleryVideoCount > 0 && <span class="chip">{roomGalleryVideoCount} video</span>}
          <span class="chip">{roomGallery.length} media</span>
        </div>
      </div>

      <div class="room-detail-gallery-shell" data-reveal>
        <article class:list={["room-detail-gallery-item room-detail-gallery-main", { "is-video": roomGalleryMain.type === "video" }]}>
          {roomGalleryMain.type === "video" ? (
            <video controls playsinline preload="metadata" poster={roomGalleryMain.poster ?? room.images[0] ?? siteMeta.heroImage}>
              <source src={roomGalleryMain.src} />
            </video>
          ) : (
            <img src={roomGalleryMain.src} alt={roomGalleryMain.title ?? `${room.name} - không gian chính`} loading="eager" />
          )}
          {roomGalleryMain.type === "video" && <span class="room-media-badge">Video</span>}
          <div class="room-media-caption">
            <strong>{roomGalleryMain.title ?? `${room.name} - góc nổi bật`}</strong>
          </div>
        </article>

        {
          roomGalleryRest.length > 0 && (
            <div class:list={["room-detail-gallery-grid", roomGalleryGridMode]}>
              {roomGalleryRest.map((media, index) => (
                <article class:list={["room-detail-gallery-item room-detail-gallery-tile", { "is-video": media.type === "video" }]}>
                  {media.type === "video" ? (
                    <video controls playsinline preload="metadata" poster={media.poster ?? room.images[0] ?? siteMeta.heroImage}>
                      <source src={media.src} />
                    </video>
                  ) : (
                    <img src={media.src} alt={media.title ?? `${room.name} - ảnh ${index + 2}`} loading="lazy" />
                  )}
                  {media.type === "video" && <span class="room-media-badge">Video</span>}
                  {media.title && (
                    <div class="room-media-caption room-media-caption-small">
                      <strong>{media.title}</strong>
                    </div>
                  )}
                </article>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container room-detail-grid">
      <article class="room-detail-card" data-reveal>
        <p class="eyebrow">Tiện nghi</p>
        <h2>Tiện nghi có sẵn trong phòng</h2>
        <ul class="room-detail-amenities">
          {room.amenities.map((amenity) => (
            <li>{amenity}</li>
          ))}
        </ul>
      </article>

      <article class="room-detail-card" data-reveal style="--delay:100ms">
        <p class="eyebrow">Thông tin nhanh</p>
        <h2>Chi tiết bố cục & vận hành</h2>
        <ul class="room-detail-facts">
          <li>
            <strong>Loại phòng</strong>
            <span>{room.type}</span>
          </li>
          <li>
            <strong>Điểm nổi bật</strong>
            <span>{room.highlight}</span>
          </li>
          <li>
            <strong>Vị trí</strong>
            <span>{siteMeta.location}</span>
          </li>
          <li>
            <strong>Nhận phòng</strong>
            <span>Từ 14:00</span>
          </li>
          <li>
            <strong>Trả phòng</strong>
            <span>Trước 12:00</span>
          </li>
        </ul>
      </article>
    </div>
  </section>

  {relatedRooms.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading section-heading-compact" data-reveal>
          <p class="eyebrow">Phòng khác</p>
          <h2>Các lựa chọn lưu trú cùng khu</h2>
        </div>

        <div class="room-related-grid">
          {relatedRooms.map((item, index) => (
            <article class="room-related-card card" data-reveal style={`--delay:${index * 90}ms`}>
              <a
                class="card-click-overlay"
                href={`/phong-nghi/${item.slug}`}
                aria-label={`Xem chi tiết phòng ${item.name}`}
              ></a>
              <div class="card-media">
                <img src={item.images[0]} alt={item.name} loading="lazy" />
              </div>
              <div class="card-body">
                <span class="card-tag">{item.type}</span>
                <h3>{item.name}</h3>
                <p>{item.summary}</p>
                <div class="meta-row">
                  <span class="chip">{item.guests}</span>
                  <span class="chip">{item.area}</span>
                </div>
                <a class="text-link" href={`/phong-nghi/${item.slug}`}>
                  Xem chi tiết phòng
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>
