---
import MainLayout from "../../layouts/MainLayout.astro";
import { getContent, getRoomBySlug } from "../../lib/content";
import { resolveSiteUrl, toAbsoluteUrl } from "../../lib/site-url";

const { slug } = Astro.params;
const room = slug ? await getRoomBySlug(slug) : null;

if (!room) {
  return Astro.redirect("/404");
}

const { rooms, siteMeta } = await getContent();
const relatedRooms = rooms.filter((item) => item.slug !== room.slug).slice(0, 2);
const roomIndex = Math.max(
  0,
  rooms.findIndex((item) => item.slug === room.slug)
);
const roomOrder = String(roomIndex + 1).padStart(2, "0");
const pageTitle = `${room.name} | Chi tiết phòng`;
const descriptionPlainText = room.description.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const pageDescription = `${room.summary} ${descriptionPlainText}`;
const roomMedia = room.media.filter((item) => item.src.trim().length > 0);
const roomGalleryItems = roomMedia.length ? roomMedia : [{ type: "image" as const, src: siteMeta.heroImage, title: room.name }];
const roomGalleryMain = roomGalleryItems[0];
const siteOrigin = resolveSiteUrl(Astro.site);
const roomUrl = toAbsoluteUrl(`/phong-nghi/${room.slug}/`, siteOrigin);
const roomImagesForSchema = roomMedia
  .filter((item) => item.type === "image")
  .slice(0, 8)
  .map((item) => toAbsoluteUrl(item.src, siteOrigin));
const roomStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Trang chủ",
        item: toAbsoluteUrl("/", siteOrigin)
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Phòng nghỉ",
        item: toAbsoluteUrl("/#phong-nghi", siteOrigin)
      },
      {
        "@type": "ListItem",
        position: 3,
        name: room.name,
        item: roomUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HotelRoom",
    name: room.name,
    description: descriptionPlainText,
    url: roomUrl,
    image: roomImagesForSchema.length ? roomImagesForSchema : [toAbsoluteUrl(roomGalleryMain.src, siteOrigin)],
    occupancy: {
      "@type": "QuantitativeValue",
      value: Number(room.guests.match(/\d+/)?.[0] ?? 2)
    },
    amenityFeature: room.amenities.map((amenity) => ({
      "@type": "LocationFeatureSpecification",
      name: amenity,
      value: true
    })),
    containedInPlace: {
      "@type": "LodgingBusiness",
      name: siteMeta.name,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Tri Tôn",
        addressRegion: "An Giang",
        addressCountry: "VN"
      }
    }
  }
];
---

<MainLayout title={pageTitle} description={pageDescription} image={roomGalleryMain.src} pageClass="room-detail-page" ogType="article">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(roomStructuredData)}></script>
  </Fragment>

  <section class="section room-detail-hero">
    <div class="container">
      <nav class="room-breadcrumb" aria-label="Điều hướng breadcrumb">
        <a href="/">Trang chủ</a>
        <span>/</span>
        <a href="/#phong-nghi">Phòng nghỉ</a>
        <span>/</span>
        <strong>{room.name}</strong>
      </nav>

      <article class="room-detail-hero-panel" data-reveal>
        <div class="room-detail-hero-media room-hero-gallery" data-room-hero-gallery>
          <div class="room-hero-main-stack">
            {roomGalleryItems.map((media, index) => (
              <figure
                class:list={["room-hero-shot", { "is-active": index === 0, "is-video": media.type === "video" }]}
                data-hero-panel
                aria-hidden={index === 0 ? "false" : "true"}
              >
                {media.type === "video" ? (
                  <video controls playsinline preload="metadata" poster={media.poster ?? siteMeta.heroImage}>
                    <source src={media.src} />
                  </video>
                ) : (
                  <img src={media.src} alt={media.title ?? `${room.name} - góc ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} />
                )}
                {media.type === "video" && <span class="room-media-badge">Video</span>}
              </figure>
            ))}
          </div>

          {roomGalleryItems.length > 1 && (
            <div class="room-hero-thumb-list" aria-label="Danh sách ảnh nổi bật của phòng">
              {roomGalleryItems.map((media, index) => (
                <button
                  class:list={["room-hero-thumb", { "is-active": index === 0 }]}
                  type="button"
                  data-hero-thumb
                  data-hero-index={index}
                  aria-label={`Xem ${media.title ?? `${room.name} - ảnh ${index + 1}`}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {media.type === "video" ? (
                    <>
                      <video muted playsinline preload="metadata" poster={media.poster ?? siteMeta.heroImage}>
                        <source src={media.src} />
                      </video>
                      <span class="room-thumb-play" aria-hidden="true">▶</span>
                    </>
                  ) : (
                    <img src={media.src} alt="" loading="lazy" />
                  )}
                  <span class="room-hero-thumb-progress" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="room-detail-hero-content">
          <p class="eyebrow">Phòng lưu trú {roomOrder}</p>
          <h1>{room.name}</h1>
          <p class="room-detail-summary">{room.summary}</p>

          <div class="room-hero-meta">
            <span>{room.type}</span>
            <span>{room.highlight}</span>
          </div>

          <div class="room-detail-stats">
            <article class="page-stat">
              <strong>{room.guests}</strong>
              <span>Sức chứa tối ưu</span>
            </article>
            <article class="page-stat">
              <strong>{room.area}</strong>
              <span>Diện tích sử dụng</span>
            </article>
            <article class="page-stat">
              <strong>{room.view}</strong>
              <span>Không gian nhìn ra</span>
            </article>
          </div>

          <div class="quick-links">
            <a class="btn btn-primary" href={siteMeta.contact.zalo} target="_blank" rel="noreferrer">
              Chat Zalo ngay
            </a>
            <a class="btn btn-secondary" href={siteMeta.contact.phoneHref}>
              {siteMeta.contact.phoneDisplay}
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section room-overview-section">
    <div class="container room-overview-grid">
      <article class="room-overview-copy" data-reveal>
        <p class="eyebrow">Tổng quan lưu trú</p>
        <h2>Không gian, trải nghiệm và bố cục phòng</h2>
        <div class="room-detail-description" set:html={room.description} />
      </article>

      <aside class="room-booking-card" data-reveal style="--delay:100ms">
        <p class="eyebrow">Thông tin nhanh</p>
        <h2>Nên biết trước khi đặt</h2>
        <ul class="room-detail-facts">
          <li>
            <strong>Loại phòng</strong>
            <span>{room.type}</span>
          </li>
          <li>
            <strong>Điểm nổi bật</strong>
            <span>{room.highlight}</span>
          </li>
          <li>
            <strong>Vị trí</strong>
            <span>{siteMeta.location}</span>
          </li>
          <li>
            <strong>Nhận phòng</strong>
            <span>Từ 14:00</span>
          </li>
          <li>
            <strong>Trả phòng</strong>
            <span>Trước 12:00</span>
          </li>
        </ul>
        <div class="quick-links">
          <a class="btn btn-primary" href={siteMeta.contact.zalo} target="_blank" rel="noreferrer">
            Hỏi phòng trống
          </a>
          <a class="btn btn-secondary" href={siteMeta.contact.phoneHref}>
            Gọi ngay
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <article class="room-detail-card room-detail-card-wide" data-reveal>
        <p class="eyebrow">Tiện nghi</p>
        <h2>Tiện nghi có sẵn trong phòng</h2>
        <ul class="room-detail-amenities">
          {room.amenities.map((amenity) => (
            <li>{amenity}</li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  {relatedRooms.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading section-heading-compact" data-reveal>
          <p class="eyebrow">Phòng khác</p>
          <h2>Các lựa chọn lưu trú cùng khu</h2>
        </div>

        <div class="room-related-grid">
          {relatedRooms.map((item, index) => (
            <article class="room-related-card card" data-reveal style={`--delay:${index * 90}ms`}>
              <a
                class="card-click-overlay"
                href={`/phong-nghi/${item.slug}`}
                aria-label={`Xem chi tiết phòng ${item.name}`}
              ></a>
              <div class="card-media">
                <img src={item.media[0].src} alt={item.name} loading="lazy" />
              </div>
              <div class="card-body">
                <span class="card-tag">{item.type}</span>
                <h3>{item.name}</h3>
                <p>{item.summary}</p>
                <div class="meta-row">
                  <span class="chip">{item.guests}</span>
                  <span class="chip">{item.area}</span>
                </div>
                <a class="text-link" href={`/phong-nghi/${item.slug}`}>
                  Xem chi tiết phòng
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    document.querySelectorAll("[data-room-hero-gallery]").forEach((gallery) => {
      const panels = Array.from(gallery.querySelectorAll("[data-hero-panel]"));
      const thumbs = Array.from(gallery.querySelectorAll("[data-hero-thumb]"));
      let activeIndex = 0;
      let timer = null;

      const setActiveHeroMedia = (nextIndex) => {
        if (!panels.length) return;
        activeIndex = (nextIndex + panels.length) % panels.length;

        panels.forEach((panel, index) => {
          const isActive = index === activeIndex;
          panel.classList.toggle("is-active", isActive);
          panel.setAttribute("aria-hidden", String(!isActive));

          const video = panel.querySelector("video");
          if (video && !isActive) video.pause();
        });

        thumbs.forEach((thumb, index) => {
          const isActive = index === activeIndex;
          thumb.classList.toggle("is-active", isActive);
          thumb.setAttribute("aria-pressed", String(isActive));
        });
      };

      const startHeroRotation = () => {
        if (panels.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        window.clearInterval(timer);
        timer = window.setInterval(() => setActiveHeroMedia(activeIndex + 1), 3600);
      };

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          setActiveHeroMedia(Number(thumb.dataset.heroIndex || 0));
          startHeroRotation();
        });
      });

      gallery.addEventListener("mouseenter", () => window.clearInterval(timer));
      gallery.addEventListener("mouseleave", startHeroRotation);
      startHeroRotation();
    });
  </script>
</MainLayout>
