# URL domain của site (bắt buộc để SEO hoạt động đúng)
# Nếu chưa có domain, để trống - site sẽ chạy được nhưng bị noindex
PUBLIC_SITE_URL=https://your-project.pages.dev

# URL PocketBase backend
PUBLIC_POCKETBASE_URL=https://your-pocketbase-instance.pocketbasecloud.com

# Đặt true nếu muốn build fail khi PocketBase không khả dụng
PUBLIC_REQUIRE_CMS=false
